{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@expense-tracker/shared": ["../../packages/shared/dist"],
      "@expense-tracker/database": ["../../packages/database/dist"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
